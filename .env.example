# ==========================================
# AI SERVICE PROVIDERS
# ==========================================
# OpenAI API Key: Used for generating articles, rewriting drafts, and DALL-E 3 image generation
OPENAI_API_KEY="your-openai-api-key"

# Gemini API Key: Alternative AI provider for article generation and image generation
GEMINI_API_KEY="your-gemini-api-key"

# Anthropic API Key: powers both the admin panel's "Generar artículo con IA"
# (Claude) SEO article generator and the interactive execution-guide
# generator (Claude + server-side web_search tool). Use a key dedicated to
# this project, not your personal Anthropic Console key.
ANTHROPIC_API_KEY="your-anthropic-api-key"

# APP_URL: The URL where this application is hosted
APP_URL="http://localhost:3000"

# ADMIN CONFIGURATION (server-only — never prefix these with VITE_, or they
# will be bundled into the public client-side JavaScript)
ADMIN_EMAIL="admin@trepola.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Get these credentials from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database Connection String for Drizzle ORM (Supabase Transaction Pooler or Direct Connection)
DATABASE_URL="postgres://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Alternative individual Postgres credentials if not using DATABASE_URL
SQL_HOST="db.your-project-ref.supabase.co"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="your-db-password"
SQL_DB_NAME="postgres"
